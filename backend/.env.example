# Copy to backend/.env and fill in. Never commit .env.
# On Vercel, set the same names in Project Settings > Environment Variables instead.

# AWS Bedrock via the Mantle endpoint
# BEDROCK_REGION is preferred; AWS_REGION also works locally but is reserved on Vercel
BEDROCK_REGION=your-region-where-mantle-works
BEDROCK_API_KEY=your-bedrock-mantle-api-key
# Exact provider-prefixed ID from your Mantle console, e.g. anthropic.<model>
BEDROCK_MODEL_ID=your-model-id

# ElevenLabs (needs Agents access)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Filled in automatically by: python setup_agents.py
ELEVENLABS_ONBOARDING_AGENT_ID=
ELEVENLABS_INTERVIEWER_AGENT_ID=

# Optional. When set, the app asks for this passcode before anything loads (use it on Vercel)
DEMO_PASSCODE=

# Optional, Vercel only: added automatically when you connect Upstash for Redis to the project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
